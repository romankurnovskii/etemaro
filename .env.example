# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC overrides (optional) ───────────────────────────────────────────
# Overrides connection.rpcUrl in user-config.json when set.
# Option A: Free/Public Solana RPC URL (highly rate-limited, but works for quick dry-runs)
# RPC_URL=https://api.mainnet-beta.solana.com
# RPC_URL=https://rpc.ankr.com/solana
RPC_URL=

# Option B: Helius Premium RPC (Recommended for production/stable runs)
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── Fallback Solana RPC (optional) ───────────────────────────────────────────
# Overrides connection.rpcUrl2 in user-config.json when set.
# Used automatically as fallback on primary RPC rate-limits (429) or transient errors.
# RPC_URL_2=https://rpc.ankr.com/solana
RPC_URL_2=

# ── LLM Provider (OpenAI-compatible) ──────────────────────────────────────────
# Examples for LLM_BASE_URL:
# - OpenRouter:              https://openrouter.ai/api/v1
# - OpenAI:                  https://api.openai.com/v1
# - Local (LM Studio):       http://localhost:1234/v1
# - Local (Ollama):          http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/healer-alpha


# ────────────────────── API keys ───────────────────────────────────────────────────
# ── Required for normal operation ─────────────────────────────────────────────
# Used by WalletAdapter.getWalletBalances() to fetch wallet balances and USD values.
HELIUS_API_KEY=
# Used by Jupiter swaps after fee claims and other swap operations.
JUPITER_API_KEY=

# ── Optional: enable only the integrations you use ────────────────────────────
# LPAgent position-data lookups. Also set api.lpAgent.enabled=true in user-config.json.
LPAGENT_API_KEY=
# Agent Meridian API authentication. Needed for authenticated Meridian requests.
AGENT_MERIDIAN_PUBLIC_API_KEY=
DEFAULT_AGENT_MERIDIAN_PUBLIC_KEY=bWVyaWRpYW4taXMtdGhlLWJlc3QtYWdlbnRz
# GMGN token-fee analysis. Also set gmgn.enabled=true and feeSource="gmgn".
# Get your free GMGN API key at https://docs.gmgn.ai/index/gmgn-agent-api
GMGN_API_KEY=

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── STRATEGY & CONFIG OVERWRITE ENVIRONMENTS ───────────────────────────────────
