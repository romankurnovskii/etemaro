# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
# Option A: Free/Public Solana RPC URL (highly rate-limited, but works for quick dry-runs)
RPC_URL=https://api.mainnet-beta.solana.com
# RPC_URL=https://rpc.ankr.com/solana

# Option B: Helius Premium RPC (Recommended for production/stable runs)
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM Provider (OpenAI-compatible) ──────────────────────────────────────────
# Examples for LLM_BASE_URL:
# - OpenRouter:              https://openrouter.ai/api/v1
# - OpenAI:                  https://api.openai.com/v1
# - Local (LM Studio):       http://localhost:1234/v1
# - Local (Ollama):          http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/healer-alpha

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=
LPAGENT_API_KEY=
DEFAULT_AGENT_MERIDIAN_PUBLIC_KEY=bWVyaWRpYW4taXMtdGhlLWJlc3QtYWdlbnRz
# Get your free Jupiter API key at https://developers.jup.ag/portal/
JUPITER_API_KEY=

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=info

# ── STRATEGY & CONFIG OVERWRITE ENVIRONMENTS ───────────────────────────────────
