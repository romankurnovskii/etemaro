{
  "name": "etemaro",
  "version": "3.4.4",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "description": "Autonomous DLMM LP agent for Meteora on Solana",
  "main": "packages/daemon/dist/Daemon.js",
  "bin": {
    "etemaro": "packages/cli/dist/Cli.js"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "start": "node --import tsx packages/daemon/src/Daemon.ts",
    "dev": "DRY_RUN=true node --import tsx packages/daemon/src/Daemon.ts",
    "cli": "node --import tsx packages/cli/src/Cli.ts",
    "balance": "node --import tsx packages/cli/src/Cli.ts balance",
    "positions": "node --import tsx packages/cli/src/Cli.ts positions",
    "candidates": "node --import tsx packages/cli/src/Cli.ts candidates",
    "screen": "node --import tsx packages/cli/src/Cli.ts screen",
    "manage": "node --import tsx packages/cli/src/Cli.ts manage",
    "performance": "node --import tsx packages/cli/src/Cli.ts performance",
    "evolve": "node --import tsx packages/cli/src/Cli.ts evolve",
    "blacklist": "node --import tsx packages/cli/src/Cli.ts blacklist",
    "lessons": "node --import tsx packages/cli/src/Cli.ts lessons",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm -r run typecheck",
    "prepare": "husky",
    "pm2:start": "pm2 start config/ecosystem.config.cjs",
    "pm2:restart": "pm2 restart config/ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop etemaro",
    "pm2:delete": "pm2 delete etemaro",
    "pm2:logs": "pm2 logs etemaro --lines 100",
    "desktop": "pnpm --filter @etemaro/desktop tauri dev",
    "postinstall": "node scripts/patch-anchor.js"
  },
  "knip": {
    "ignore": [
      "discord-listener/**",
      "dist/**"
    ]
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "jsonrepair": "^3.15.0",
    "node-cron": "^3.0.3",
    "openai": "^7.5.0",
    "pm2": "^7.0.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.3.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "**/*.{json,md,html,css}": [
      "prettier --write"
    ]
  }
}
