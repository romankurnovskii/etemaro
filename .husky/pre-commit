# Isolate hook runs from the real user home; keystore/SKILL.md writes must not
# depend on ~/.config/etemaro being writable.
ETEMARO_HOME="${TMPDIR:-/tmp}/etemaro-precommit-$$"
export ETEMARO_HOME
mkdir -p "$ETEMARO_HOME"

node scripts/lint-staged.mjs
pnpm -r build
pnpm test

# Validate config + strategy JSON before commit (single source of truth: the Etemaro CLI).
# Config uses --env-optional so structural errors are caught without requiring deployment secrets.
# The private strategy library gets --active so the active-strategy smartWalletListId gate is checked.
CONFIG_CANDIDATE=""
for f in config/instances/agent-default.json config/agent-config.json config/user-config.json; do
  if [ -f "$f" ]; then CONFIG_CANDIDATE="$f"; break; fi
done
if [ -n "$CONFIG_CANDIDATE" ]; then
  pnpm --silent run validate:config --env-optional || exit 1
fi

if [ -f config/shared/strategy-library.json ]; then
  pnpm --silent run validate:strategy --active config/shared/strategy-library.json || exit 1
fi

# Shared strategy library is bundled in code; only the private overlay is validated above.
